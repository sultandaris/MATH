def current_cluster(data, cluster):
    for j in range(cluster):
        print(f"\nData Cluster {j + 1}")
        for i in range(len(data)):
            if data[i][0] == j + 1:
                print(data[i])

def center_points(data, cluster):
    center_points = []
    for i in range(cluster):
        center = []
        count = 0
        for j in range(len(data)):
            if(data[j][0] == i+1):
                count += 1
                for k in range(1, len(data[0])):
                    if len(center) < len(data[0]) - 1:
                        center.append(data[j][k])
                    else:
                        center[k-1] += data[j][k]
        if count > 0:
            center_points.append([x / count for x in center])
    return center_points

def assign(data, center):
    for i in range(len(data)):
        for j in range(len(center)):
            dist = 0
            for k in range(1, len(data[0])):
                dist += (data[i][k] - center[j][k-1]) ** 2
            dist = sqrt(dist)
            if j == 0:
                min_dist = dist
                data[i][0] = j + 1
            else:
                if dist < min_dist:
                    min_dist = dist
                    data[i][0] = j + 1
    
def clustering(data, cluster):
    for i in range(len(data)):
        data[i][0] = (i % cluster) + 1
    lock = True
    count = 0
    while(lock):
        old = [row[:] for row in data]        
        assign(data, center_points(data, cluster))
        count+=1
        if old == data:
            lock = False

def elbow(data): 
    nilai_k = []
    for i in range(1, len(data)):
        clustering(data, i)
        center = center_points(data, i) 
        total_dist = 0
        for j in range(len(center)):
            for k in range(len(data)):
                if data[k][0] == j + 1:
                    dist = 0
                    for l in range(1, len(data[0])):
                        dist += (data[k][l] - center[j][l-1]) ** 2
                    dist = sqrt(dist)
                    total_dist += dist
        nilai_k.append(total_dist)

    plt.plot(range(1, len(data)), nilai_k)
    plt.xticks(range(1, len(data)))
    plt.ylabel('Total Distance')
    plt.title('Elbow Method for Optimal k')
    plt.grid()
    plt.show()

elbow(data)
